{
  "id": "gh",
  "name": "GitHub CLI",
  "category": "git",
  "summary": "Work with GitHub pull requests, issues and releases from the terminal.",
  "publisher": {
    "name": "GitHub",
    "url": "https://github.com"
  },
  "homepage": "https://cli.github.com",
  "license": "MIT",
  "keywords": [
    "github",
    "gh",
    "git",
    "pull request",
    "issues"
  ],
  "detect": {
    "command": "gh",
    "version": [
      "gh",
      "--version"
    ]
  },
  "platforms": {
    "wsl": {
      "families": [
        "apt"
      ],
      "driver": "apt",
      "account": "root",
      "packages": [
        "gh"
      ]
    },
    "windows": {
      "driver": "winget",
      "id": "GitHub.cli",
      "scope": "machine"
    }
  },
  "signIn": "later",
  "updates": "driver"
}
