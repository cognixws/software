    {
      "id": "gh", "name": "GitHub CLI", "category": "git",
      "summary": "Work with GitHub pull requests, issues and releases from the terminal.",
      "publisher": { "name": "GitHub", "url": "https://github.com" },
      "homepage": "https://cli.github.com", "license": "MIT",
      "keywords": ["github", "gh", "git", "pull request", "issues"],
      "detect": { "command": "gh", "version": ["gh", "--version"] },
      "platforms": { "wsl": { "families": ["apt"], "driver": "apt", "account": "root",
        "packages": ["gh"] } },
      "signIn": "later", "updates": "driver"
    },
    {
      "id": "docker", "name": "Docker Engine", "category": "containers",
      "summary": "Run containers in your Linux environment.",
      "publisher": { "name": "Docker Inc.", "url": "https://www.docker.com" },
      "homepage": "https://docs.docker.com/engine/", "license": "Apache-2.0",
      "keywords": ["docker", "compose", "buildx", "containers"],
      "detect": { "command": "docker", "version": ["docker", "--version"] },
      "platforms": { "wsl": { "families": ["apt"], "driver": "apt-repo", "account": "root",
        "hosts": ["download.docker.com"],
        "repo": { "url": "https://download.docker.com/linux/{base}", "suite": "{codename}", "components": "stable",
                  "key": "https://download.docker.com/linux/{base}/gpg",
                  "fingerprint": "9DC858229FC7DD38854AE2D88D81803C0EBFCD88" },
        "packages": ["docker-ce", "docker-ce-cli", "containerd.io", "docker-buildx-plugin", "docker-compose-plugin"],
        "conflicts": ["docker.io", "podman-docker"],
        "after": ["docker-access"],
        "remove": { "packages": ["docker-ce", "docker-ce-cli"], "keeps": "images and volumes" } } },
      "grants": "Anyone who can use Docker gets full administrator control of this Linux environment.",
      "signIn": "none", "updates": "driver"
    },
    {
      "id": "tailscale", "name": "Tailscale", "category": "networking",
      "summary": "Reach this computer from your other devices over a private network.",
      "publisher": { "name": "Tailscale Inc.", "url": "https://tailscale.com" },
      "homepage": "https://tailscale.com/kb/1031/install-linux", "license": "BSD-3-Clause",
      "keywords": ["tailscale", "vpn", "wireguard", "network", "remote"],
      "detect": { "command": "tailscale", "version": ["tailscale", "version"] },
      "platforms": { "wsl": { "families": ["apt"], "driver": "apt-repo", "account": "root",
        "hosts": ["pkgs.tailscale.com"],
        "repo": { "url": "https://pkgs.tailscale.com/stable/{base}", "suite": "{codename}", "components": "main",
                  "key": "https://pkgs.tailscale.com/stable/{base}/{codename}.noarmor.gpg",
                  "fingerprint": "2596A99EAAB33821893C0A79458CA832957F5868" },
        "packages": ["tailscale"] } },
      "signIn": "later", "updates": "driver"
    },
    {
      "id": "wrangler", "name": "Cloudflare Wrangler", "category": "cloud",
      "summary": "Build and deploy Cloudflare Workers and Pages.",
      "publisher": { "name": "Cloudflare", "url": "https://www.cloudflare.com" },
      "homepage": "https://developers.cloudflare.com/workers/wrangler/", "license": "MIT OR Apache-2.0",
      "keywords": ["cloudflare", "wrangler", "workers", "pages", "deploy"],
      "detect": { "command": "wrangler", "version": ["wrangler", "--version"] },
      "platforms": { "wsl": { "driver": "npm-global", "account": "user", "package": "wrangler",
        "env": { "WRANGLER_SEND_METRICS": "false" } } },
      "dependsOn": ["nodejs"], "signIn": "later", "updates": "driver"
    },
    {
      "id": "vercel", "name": "Vercel CLI", "category": "cloud",
