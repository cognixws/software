      "platforms": { "wsl": { "driver": "npm-global", "account": "user", "package": "vercel",
        "env": { "VERCEL_TELEMETRY_DISABLED": "1" } } },
      "dependsOn": ["nodejs"], "signIn": "later", "updates": "driver"
    },
