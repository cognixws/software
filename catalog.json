    {
      "id": "tmux", "name": "tmux", "category": "runtime", "required": true,
      "summary": "Keeps every agent's terminal running when no window is open.",
      "publisher": { "name": "tmux", "url": "https://github.com/tmux/tmux" },
      "homepage": "https://github.com/tmux/tmux/wiki", "license": "ISC",
      "keywords": ["tmux", "terminal", "multiplexer"],
      "detect": { "command": "tmux", "version": ["tmux", "-V"], "pattern": "([0-9]+\\.[0-9]+[a-z]?)" },
      "platforms": { "wsl": { "driver": "setup" } }
    },
    {
      "id": "git", "name": "Git", "category": "git", "required": true,
